[Unit]
Description=signal-agent - pull queued messages (the .path unit backs up new bytes)
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Settings come from ~/.config/signal-agent.env, which bin/signal-agent loads itself.
ExecStart=%h/bin/signal-agent receive
