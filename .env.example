# signal-agent-pipeline — export these in your shell profile (never commit real values)
SIGNAL_CLI_BIN=/opt/signal-cli/bin/signal-cli   # where you unpacked signal-cli
SIGNAL_HOME=$HOME/.signal-agent                  # ledgers: messages.jsonl / sent.jsonl
SIGNAL_DEVICE_NAME=my-agent-box                  # name shown in Signal > Linked Devices
#JAVA_HOME_SIGNAL_CLI=/opt/jdk25                 # only if system java is older than signal-cli needs
#SIGNAL_JNI_PATH=$HOME/lib/jni                   # only if libsignal JNI must be pinned
#SIGNAL_RCLONE_REMOTE=gdrive                     # optional off-box backup of the ledgers
#SIGNAL_RCLONE_PATH=signal-agent-backup
# fleet-drop (run on any other machine): the ssh target of the box above
FLEET_DROP_HOST=user@relay-host
#FLEET_DROP_HOST_FALLBACK=user@relay-host-public-ip
