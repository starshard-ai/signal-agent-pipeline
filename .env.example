# signal-agent-pipeline settings. Copy to ~/.config/signal-agent.env and edit.
# bin/signal-agent loads this file itself (interactive shells, systemd, cron, ssh).
# Never commit real values.
#
# Format rules (so the file also stays valid as a systemd EnvironmentFile):
#   - one VAR=value per line, comments only on their own lines
#   - values containing spaces in "double quotes"
#   - absolute paths only (no $HOME, no ~)

# Path to the signal-cli launcher you unpacked (use signal-cli 0.14.7; skip 0.14.8).
SIGNAL_CLI_BIN=/opt/signal-cli/bin/signal-cli

# Name shown on your phone under Signal > Linked Devices.
SIGNAL_DEVICE_NAME=my-agent-box

# Java 25 for signal-cli. Required unless JAVA_HOME already points at a Java 25
# or a Java 25 `java` is first on PATH.
#JAVA_HOME_SIGNAL_CLI=/opt/jdk25

# Ledger directory (messages.jsonl / sent.jsonl). Default: <your home>/.signal-agent
# The systemd .path unit only watches the default location.
#SIGNAL_HOME=/home/you/.signal-agent

# Optional command prefix, e.g. a proxy wrapper when Signal is blocked (INSTALL.md step 5).
#SIGNAL_CLI_PREFIX="proxychains4 -q -f /home/you/.config/signal-agent-proxychains.conf"

# Only if the libsignal JNI library must be pinned.
#SIGNAL_JNI_PATH=/home/you/lib/jni

# Optional off-box backup of the ledgers via rclone.
#SIGNAL_RCLONE_REMOTE=gdrive
#SIGNAL_RCLONE_PATH=signal-agent-backup

# fleet-drop runs on your OTHER machines; set these there, not on this box:
#FLEET_DROP_HOST=user@relay-host
#FLEET_DROP_HOST_FALLBACK=user@relay-host-public-ip
